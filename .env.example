# --- LangSmith (sandbox + Prompt Hub + Context Hub + tracing) ---
# A WORKSPACE-SCOPED key. It resolves its own tenant — nothing else needed.
# Used for the sandbox API, Prompt Hub, Context Hub, and tracing.
# (An org-scoped key 404s on Hub repos / 403s on writes; if you must use one,
#  also set LANGSMITH_WORKSPACE_ID.)
LANGSMITH_API_KEY=lsv2_pt_...
# Optional: a key dedicated to the LLM gateway, if different from the above.
# LANGSMITH_API_KEY_GATEWAY=lsv2_pt_...
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=code-gen-agent
# LANGSMITH_WORKSPACE_ID=          # only for org-scoped keys

# --- Model routing ---
# By default the agent routes model calls through the LangSmith LLM gateway,
# authenticated with LANGSMITH_API_KEY above — no provider key needed.
# CODE_GEN_USE_GATEWAY=true
# LANGSMITH_GATEWAY_URL=https://gateway.smith.langchain.com
#
# To call the provider directly instead, set CODE_GEN_USE_GATEWAY=false and
# provide the provider key:
# CODE_GEN_USE_GATEWAY=false
# ANTHROPIC_API_KEY=sk-ant-...

# --- Agent configuration (optional; defaults shown) ---
# CODE_GEN_MODEL=anthropic:claude-sonnet-4-6
# CODE_GEN_PROMPT_REPO=code-gen-agent
# CODE_GEN_SKILLS=python-codegen,shared-workspace   # Context Hub skill repos to load
# CODE_GEN_MEMORY_REPO=code-gen-agent-memory
# CODE_GEN_SANDBOX_NAME=code-gen-agent-sandbox   # shared warm sandbox, reused or
#                                        # created at startup. The key above must
#                                        # be its creator (or have sandboxes:exec).
